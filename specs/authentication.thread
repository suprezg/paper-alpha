syntax = behavior

Feature: "User Authentication and Registration"
  Note: [[As a Paper-Alpha desktop user
  I want to register an account, obtain backup security keys, and access recovery workflows
  So that I can log in securely and regain access to my account if I lose my password.]]

  Rule: "Registered users must provide valid credentials to access the application"

    Scenario: "Successful login with valid credentials"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\" and password \"SecurePass123!\""
      When "the user enters username \"quant_trader\" and password \"SecurePass123!\""
      And "clicks the \"Login\" button"
      Then "the user should be authenticated successfully"
      And "the core application dashboard should be displayed"

    Scenario: "Unsuccessful login with invalid credentials - Case 1"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\" and password \"SecurePass123!\""
      When "the user enters username \"quant_trader\" and password \"WrongPassword!\""
      And "clicks the \"Login\" button"
      Then "an error message \"Invalid credentials\" should be displayed"
      And "the user should remain on the login page"

    Scenario: "Unsuccessful login with invalid credentials - Case 2"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\" and password \"SecurePass123!\""
      When "the user enters username \"unknown_user\" and password \"SecurePass123!\""
      And "clicks the \"Login\" button"
      Then "an error message \"Invalid credentials\" should be displayed"
      And "the user should remain on the login page"

    Scenario: "Unsuccessful login with invalid credentials - Case 3"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\" and password \"SecurePass123!\""
      When "the user enters username \"unknown_user\" and password \"WrongPassword!\""
      And "clicks the \"Login\" button"
      Then "an error message \"Invalid credentials\" should be displayed"
      And "the user should remain on the login page"

  Rule: "Unregistered users can create an account and must safely store their generated security keys"

    Scenario: "Successful account registration displays single security keys dialog"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "no registered user exists with username \"new_trader\""
      When "the user clicks on the \"Create Account\" button"
      And "fills in the registration form with username \"new_trader\" and password \"NewPass456!\""
      And "clicks the \"Okay\" button"
      Then "a notification \"Account created successfully\" should be displayed"
      And "a security keys dialog should appear displaying 10 single-use backup codes"
      And "the dialog should also display a one-time recovery phrase"
      And "advice text regarding secure storage and emergency usage should be shown"
      And "the user should not be redirected to the login page yet"

    Scenario: "Copying backup codes or recovery phrase to clipboard"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "the security keys dialog is displayed after registration"
      When "the user clicks the \"Copy\" button for the backup codes section"
      Then "all 10 backup codes should be copied to the clipboard"
      When "the user clicks the \"Copy\" button for the recovery phrase section"
      Then "the one-time recovery phrase should be copied to the clipboard"

    Scenario: "Closing security keys dialog redirects user to login page"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "the security keys dialog is displayed after registration"
      When "the user clicks the \"Okay\" button on the security keys dialog"
      Then "the security keys dialog should close"
      And "the user should be redirected to the login page"

    Scenario: "Unsuccessful account registration when username already exists"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user already exists with username \"existing_trader\""
      When "the user clicks on the \"Create Account\" button"
      And "fills in the registration form with username \"existing_trader\" and password \"NewPass456!\""
      And "clicks the \"Okay\" button"
      Then "an error message \"Username already taken\" should be displayed"
      And "the user should remain on the registration page"
      But "the user should not be redirected to the login page"

    Scenario: "Unsuccessful account registration with invalid form inputs - Case 1"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      When "the user clicks on the \"Create Account\" button"
      And "fills in the registration form with username \"\" and password \"Pass123!\""
      And "clicks the \"Okay\" button"
      Then "an error message \"Username is required\" should be displayed"
      And "the user should remain on the registration page"
      But "the user should not be redirected to the login page"

    Scenario: "Unsuccessful account registration with invalid form inputs - Case 2"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      When "the user clicks on the \"Create Account\" button"
      And "fills in the registration form with username \"new_trader\" and password \"\""
      And "clicks the \"Okay\" button"
      Then "an error message \"Password is required\" should be displayed"
      And "the user should remain on the registration page"
      But "the user should not be redirected to the login page"

    Scenario: "Unsuccessful account registration with invalid form inputs - Case 3"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      When "the user clicks on the \"Create Account\" button"
      And "fills in the registration form with username \"\" and password \"\""
      And "clicks the \"Okay\" button"
      Then "an error message \"Form cannot be empty\" should be displayed"
      And "the user should remain on the registration page"
      But "the user should not be redirected to the login page"

  Rule: "Users can log in using a single-use backup code if they forgot their password"

    Scenario: "Forgot Password fails when username does not exist"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      When "the user clicks on the \"Forgot Password\" button"
      And "enters username \"non_existent_user\""
      And "clicks the \"Next\" button"
      Then "an error message \"Invalid username\" should be displayed"
      And "the system should stop and not prompt for a backup code"

    Scenario: "Successful login with a valid, unused backup code"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user \"quant_trader\" has a valid, unused backup code \"BC-1234-5678\""
      When "the user clicks on the \"Forgot Password\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters backup code \"BC-1234-5678\""
      And "clicks the \"Submit\" button"
      Then "the user should be authenticated successfully"
      And "the backup code \"BC-1234-5678\" should be permanently deleted from the database"
      And "the core application dashboard should be displayed"

    Scenario: "Failed login when providing a previously used backup code"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user \"quant_trader\" has already consumed backup code \"BC-1234-5678\""
      When "the user clicks on the \"Forgot Password\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters backup code \"BC-1234-5678\""
      And "clicks the \"Submit\" button"
      Then "an error message \"Invalid backup code\" should be displayed"
      And "the user should remain unauthenticated"

    Scenario: "Failed login when providing an entirely invalid backup code"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\""
      When "the user clicks on the \"Forgot Password\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters backup code \"INVALID-CODE-99\""
      And "clicks the \"Submit\" button"
      Then "an error message \"Invalid backup code\" should be displayed"
      And "the user should remain unauthenticated"

  Rule: "Users can recover their account using their one-time recovery phrase"

    Scenario: "Account Recovery fails when username does not exist"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      When "the user clicks on the \"Recover Account\" button"
      And "enters username \"non_existent_user\""
      And "clicks the \"Next\" button"
      Then "an error message \"Invalid username\" should be displayed"
      And "the system should stop and not prompt for a recovery phrase"

    Scenario: "Successful account recovery with a valid, unused recovery phrase"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user \"quant_trader\" has an unused recovery phrase \"apple banana cherry dragon eagle falcon\""
      When "the user clicks on the \"Recover Account\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters recovery phrase \"apple banana cherry dragon eagle falcon\""
      And "clicks the \"Submit\" button"
      Then "the user should be authenticated successfully"
      And "the recovery phrase should be marked as consumed in the database"
      And "the core application dashboard should be displayed"

    Scenario: "Failed account recovery with a previously used recovery phrase"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user \"quant_trader\" has already consumed their recovery phrase"
      When "the user clicks on the \"Recover Account\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters recovery phrase \"apple banana cherry dragon eagle falcon\""
      And "clicks the \"Submit\" button"
      Then "an error message \"Invalid recovery phrase\" should be displayed"
      And "the user should remain unauthenticated"

    Scenario: "Failed account recovery with an invalid recovery phrase"
      Given "the Paper-Alpha core application is launched"
      And "the user is on the authentication screen"
      And "a registered user exists with username \"quant_trader\""
      When "the user clicks on the \"Recover Account\" button"
      And "enters username \"quant_trader\""
      And "clicks the \"Next\" button"
      And "enters recovery phrase \"wrong random phrase test words\""
      And "clicks the \"Submit\" button"
      Then "an error message \"Invalid recovery phrase\" should be displayed"
      And "the user should remain unauthenticated"