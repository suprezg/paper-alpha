syntax = behavior

Feature: "Modular Canvas Workspaces and Widget Management"
  Note: [[As an authenticated Paper-Alpha user
  I want flexible, scrollable canvas layouts on Analysis, Execution, and Monitoring pages
  So that I can customize my visual workspace using widgets isolated to their respective plugin domains.]]

  Rule: "All modular pages provide a dual-axis scrollable grid canvas"

    Scenario: "Rendering canvas grid on modular pages - Case 1"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user navigates to the \"Analysis\" page"
      Then "a 2D canvas grid should be rendered"
      And "the canvas grid should be scrollable both vertically and horizontally"
      And "any previously saved widget layout for \"Analysis\" should be loaded"

    Scenario: "Rendering canvas grid on modular pages - Case 2"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user navigates to the \"Execution\" page"
      Then "a 2D canvas grid should be rendered"
      And "the canvas grid should be scrollable both vertically and horizontally"
      And "any previously saved widget layout for \"Execution\" should be loaded"

    Scenario: "Rendering canvas grid on modular pages - Case 3"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user navigates to the \"Monitoring\" page"
      Then "a 2D canvas grid should be rendered"
      And "the canvas grid should be scrollable both vertically and horizontally"
      And "any previously saved widget layout for \"Monitoring\" should be loaded"

  Rule: "Users can toggle edit mode to drag, drop, resize, and remove widgets"

    Scenario: "Toggling workspace customization mode - Case 1"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Analysis\" page"
      When "the user clicks the \"Customize Workspace\" button in the top-right corner"
      Then "the Widget Selection Panel should open from the side"
      And "all active canvas widgets should enter a floatable, editable state"
      When "the user clicks the \"Customize Workspace\" button again"
      Then "the Widget Selection Panel should close"
      And "all canvas widgets should lock into their static display state"

    Scenario: "Toggling workspace customization mode - Case 2"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Execution\" page"
      When "the user clicks the \"Customize Workspace\" button in the top-right corner"
      Then "the Widget Selection Panel should open from the side"
      And "all active canvas widgets should enter a floatable, editable state"
      When "the user clicks the \"Customize Workspace\" button again"
      Then "the Widget Selection Panel should close"
      And "all canvas widgets should lock into their static display state"

    Scenario: "Toggling workspace customization mode - Case 3"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Monitoring\" page"
      When "the user clicks the \"Customize Workspace\" button in the top-right corner"
      Then "the Widget Selection Panel should open from the side"
      And "all active canvas widgets should enter a floatable, editable state"
      When "the user clicks the \"Customize Workspace\" button again"
      Then "the Widget Selection Panel should close"
      And "all canvas widgets should lock into their static display state"

    Scenario: "Dragging a widget from panel to canvas"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Analysis\" page in customization mode"
      And "the Widget Selection Panel is open"
      When "the user drags \"RSI Chart Widget\" from the Widget Selection Panel"
      And "drops it onto position (X: 100, Y: 200) on the canvas grid"
      Then "the \"RSI Chart Widget\" should be mounted on the canvas at position (X: 100, Y: 200)"
      And "the updated workspace layout should be saved to the Core database"

    Scenario: "Removing a widget by dragging it back to the panel"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Execution\" page in customization mode"
      And "\"Orders Table Widget\" is placed on the canvas"
      When "the user drags \"Orders Table Widget\" from the canvas"
      And "drops it into the Widget Selection Panel"
      Then "\"Orders Table Widget\" should be removed from the canvas"
      And "\"Orders Table Widget\" should become available again inside the panel"

    Scenario: "Resizing and rearranging canvas widgets"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Analysis\" page in customization mode"
      And "\"Sentiment Gauge Widget\" is mounted on the canvas"
      When "the user drags the resize handle of \"Sentiment Gauge Widget\" to width 4 and height 3"
      And "moves the widget to position (X: 300, Y: 0)"
      Then "\"Sentiment Gauge Widget\" should re-render with width 4 and height 3 at position (X: 300, Y: 0)"
      And "neighboring widgets should reflow dynamically without overlapping"

  Rule: "Each modular page restricts widget availability strictly to its designated plugin category"

    Scenario: "Analysis page displays only Data Feed and Data Process widgets"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user opens the Widget Selection Panel on the \"Analysis\" page"
      Then "the panel should only display widgets registered under \"Data Feed Plugins\" or \"Data Process Plugins\""
      And "no widgets registered under \"Broker Plugins\" should be visible or selectable"

    Scenario: "Execution and Monitoring pages display only Broker widgets - Case 1"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user opens the Widget Selection Panel on the \"Execution\" page"
      Then "the panel should only display widgets registered under \"Broker Plugins\""
      And "no widgets registered under \"Data Feed Plugins\" or \"Data Process Plugins\" should be visible"

    Scenario: "Execution and Monitoring pages display only Broker widgets - Case 2"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      When "the user opens the Widget Selection Panel on the \"Monitoring\" page"
      Then "the panel should only display widgets registered under \"Broker Plugins\""
      And "no widgets registered under \"Data Feed Plugins\" or \"Data Process Plugins\" should be visible"

    Scenario: "Blocking cross-domain widget drops"
      Given "the user has successfully authenticated"
      And "the Core workspace manager is initialized"
      And "the user is on the \"Execution\" page in customization mode"
      When "an unauthorized \"Data Feed Plugin\" widget payload is injected onto the canvas"
      Then "the Core workspace manager should reject the placement"
      And "an error message \"Widget category not permitted on Execution workspace\" should be displayed"