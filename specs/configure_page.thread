syntax = behavior

Feature: "Application Configuration, Security, and Theme Management"
  Note: [[As an authenticated Paper-Alpha user
  I want to manage active plugins, rescan plugin directories, manage secure secrets, account recovery keys, and visual themes on the Configure page
  So that I can customize my workspace, discover new plugins, monitor account security, and keep credentials isolated.]]

  Rule: "Users can view, toggle, and dynamically rescan compliant plugins across three distinct categories"

    Scenario: "Displaying plugins organized by category"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      Then "the Configure page should display three plugin categories: \"Broker Plugins\", \"Data Feed Plugins\", and \"Logic Plugins\""
      And "each category should list its available plugins with an interactive toggle switch"

    Scenario: "Toggling compliant plugins on and off - Case 1"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      When "the user sets the toggle for plugin \"Binance Broker\" under category \"Broker Plugins\" to \"Enabled\""
      Then "the state of plugin \"Binance Broker\" should be updated to \"Enabled\""
      And "the updated plugin state should be saved to the Core SQLCipher database"

    Scenario: "Toggling compliant plugins on and off - Case 2"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      When "the user sets the toggle for plugin \"Yahoo Finance\" under category \"Data Feed Plugins\" to \"Enabled\""
      Then "the state of plugin \"Yahoo Finance\" should be updated to \"Enabled\""
      And "the updated plugin state should be saved to the Core SQLCipher database"

    Scenario: "Toggling compliant plugins on and off - Case 3"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      When "the user sets the toggle for plugin \"RSI Analytics\" under category \"Logic Plugins\" to \"Disabled\""
      Then "the state of plugin \"RSI Analytics\" should be updated to \"Disabled\""
      And "the updated plugin state should be saved to the Core SQLCipher database"

    Scenario: "Rescanning local directories to discover newly added plugins"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user has added a new plugin \"MACD Oscillator\" to the local plugins folder after application startup"
      And "\"MACD Oscillator\" is not currently visible on the Configure page"
      When "the user clicks the \"Rescan Plugins\" button at the top of the page"
      Then "the Core engine should rescan the local plugin manifests and directory"
      And "the newly discovered plugin \"MACD Oscillator\" should appear under the \"Logic Plugins\" category"
      And "a notification \"Plugin rescan complete. 1 new plugin discovered.\" should be displayed"

  Rule: "Structurally non-compliant or invalid plugins are locked and cannot be enabled"

    Scenario: "Displaying invalid or non-adherent plugins as disabled"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "a plugin \"MalformedFeed\" exists that does not adhere to the required plugin protocol structure"
      Then "the plugin \"MalformedFeed\" should be displayed with a disabled toggle"
      And "a structural warning status \"Interface Validation Failed\" should be shown next to \"MalformedFeed\""

    Scenario: "Preventing users from enabling non-compliant plugins"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "a plugin \"MalformedFeed\" exists that does not adhere to the required plugin protocol structure"
      When "the user attempts to click the toggle for \"MalformedFeed\""
      Then "the toggle switch should remain in the \"Disabled\" state"
      And "an error message \"Cannot enable plugin: structural protocol validation failed\" should be displayed"
      But "the Core engine should not spawn or execute the \"MalformedFeed\" plugin process"

  Rule: "Secure variables are stored in the Core database with granular, read-only permissions per plugin"

    Scenario: "Adding a secure variable with plugin access control lists"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user navigates to the \"Secure Variables\" section on the Configure Page"
      When "the user enters variable name \"BINANCE_API_KEY\" and value \"secret_key_998877\""
      And "grants access permissions to plugin \"Binance Broker\""
      And "denies access permissions to plugin \"Yahoo Finance\""
      And "clicks the \"Save Variable\" button"
      Then "the variable \"BINANCE_API_KEY\" should be stored encrypted in the Core SQLCipher database"
      And "the variable \"BINANCE_API_KEY\" should not be written to any plugin-specific database"
      And "a notification \"Secure variable saved successfully\" should be displayed"

    Scenario: "Granting read-only access to authorized plugins"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "a secure variable \"BINANCE_API_KEY\" is configured with read permission for \"Binance Broker\""
      When "the \"Binance Broker\" plugin requests to read \"BINANCE_API_KEY\" during execution"
      Then "the Core engine should provide the decrypted value in memory to \"Binance Broker\""

    Scenario: "Blocking authorized plugins from updating secure variables"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      When "the \"Binance Broker\" plugin attempts to update or overwrite \"BINANCE_API_KEY\""
      Then "the modification request should be rejected by the Core engine"
      And "the original value of \"BINANCE_API_KEY\" in the Core database should remain unchanged"

    Scenario: "Blocking unauthorized plugins from reading secure variables"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "a secure variable \"BINANCE_API_KEY\" is configured with access denied for \"Yahoo Finance\""
      When "the \"Yahoo Finance\" plugin requests to read \"BINANCE_API_KEY\""
      Then "the Core engine should reject the read request with an unauthorized error"
      And "no credential data should be exposed to \"Yahoo Finance\""

  Rule: "Users can view and regenerate backup codes and recovery phrases from the Configure page"

    Scenario: "Backup codes and recovery phrase are masked by default and revealed via eye icon"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user is in the \"Security Credentials\" section of the Configure page"
      Then "the remaining backup codes should be hidden by default"
      And "the recovery phrase should be hidden by default"
      When "the user clicks the \"eye icon\" next to Backup Codes"
      Then "the remaining unused backup codes should become visible"
      When "the user clicks the \"eye icon\" next to Recovery Phrase"
      Then "the unused recovery phrase should become visible"

    Scenario: "Regenerating backup codes displays a dedicated dialog"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user is in the \"Security Credentials\" section"
      When "the user clicks the \"Regenerate Backup Codes\" button"
      Then "a modal dialog should appear displaying 10 new backup codes"
      And "advice text instructing the user to store the codes securely should be shown"
      When "the user clicks the \"Copy\" button in the dialog"
      Then "the 10 new backup codes should be copied to the clipboard"
      When "the user clicks the \"Okay\" button"
      Then "the modal dialog should close"
      And "the new backup codes should replace the old ones in the database"

    Scenario: "Regenerating recovery phrase displays a dedicated dialog and clears active alert"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user is in the \"Security Credentials\" section"
      And "a top-level alert \"Recovery phrase is not configured\" is currently visible"
      When "the user clicks the \"Regenerate Recovery Phrase\" button"
      Then "a modal dialog should appear displaying a new recovery phrase"
      And "advice text instructing the user to keep the phrase safe should be shown"
      When "the user clicks the \"Copy\" button in the dialog"
      Then "the new recovery phrase should be copied to the clipboard"
      When "the user clicks the \"Okay\" button"
      Then "the modal dialog should close"
      And "the top-level alert \"Recovery phrase is not configured\" should automatically disappear"

  Rule: "Prominent alerts are displayed at the top of the Configure page when security keys are exhausted"

    Scenario: "Displaying top alert when backup codes are exhausted"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user has used all 10 backup codes"
      And "the user has a valid, unconsumed recovery phrase"
      Then "an alert banner \"Backup codes not configured\" should be displayed at the very top of the Configure page"
      But "no alert for the recovery phrase should be shown"

    Scenario: "Displaying top alert when recovery phrase is consumed"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user has remaining unused backup codes"
      And "the user has already consumed their recovery phrase"
      Then "an alert banner \"Recovery phrase is not configured\" should be displayed at the very top of the Configure page"
      But "no alert for backup codes should be shown"

    Scenario: "Displaying dual top alerts when both backup codes and recovery phrase are exhausted"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user has used all 10 backup codes"
      And "the user has already consumed their recovery phrase"
      Then "an alert banner \"Backup codes not configured\" should be displayed at the very top of the Configure page"
      And "an alert banner \"Recovery phrase is not configured\" should also be displayed at the very top of the Configure page"

  Rule: "Users can customize color tokens, corner radius, or choose preset themes"

    Scenario: "Applying pre-configured theme presets - Case 1"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user navigates to the \"Appearance\" section on the Configure Page"
      When "the user clicks on the \"Light\" theme button"
      Then "the application theme should switch to \"Light\""
      And "Background, Foreground, Primary, Secondary, and Tertiary colors should update to their \"Light\" defaults"
      And "the corner radius should update to the \"Light\" default value"
      And "the chosen theme preset should be saved to the user settings"

    Scenario: "Applying pre-configured theme presets - Case 2"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user navigates to the \"Appearance\" section on the Configure Page"
      When "the user clicks on the \"Dark\" theme button"
      Then "the application theme should switch to \"Dark\""
      And "Background, Foreground, Primary, Secondary, and Tertiary colors should update to their \"Dark\" defaults"
      And "the corner radius should update to the \"Dark\" default value"
      And "the chosen theme preset should be saved to the user settings"

    Scenario: "Customizing individual theme colors and border radius slider"
      Given "the user has successfully authenticated"
      And "the user is redirected to the \"Configure Page\""
      And "the user navigates to the \"Appearance\" section on the Configure Page"
      When "the user customizes the \"Primary\" color picker"
      And "customizes the \"Secondary\" color picker"
      And "customizes the \"Tertiary\" color picker"
      And "customizes the \"Background\" color picker"
      And "customizes the \"Foreground\" color picker"
      And "adjusts the corner radius slider to \"8px\""
      Then "the UI should dynamically update to reflect the custom colors and corner radius"
      And "the custom visual settings should be persisted in the Core SQLCipher database"