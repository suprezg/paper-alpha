Feature PluginPackagingAndValidation
{
    !Note [[
        Governs plugin distribution specifications, standard package layouts, manifest schema validation,
        Data Feed plugin emissions declarations ('streaming' vs 'non_streaming'), Data Consumer plugin
        consumptions declarations, multi-language backend target support (native binaries, sandboxed WASM,
        interpreted Python scripts), Declarative Widget Schema parsing for native Slint views, nested container
        structures (Cards, Tiles, Grids, Groups), and error enforcement for missing files or malformed JSON manifests.
    ]]

    !Diagram PluginValidationFlow
    [[
        ```mermaid
        flowchart TD
            Package([Plugin Package Folder]) --> Scan[PluginScanner::scanDirectory]
            Scan --> Parse[PluginScanner::validateManifest]
            Parse --> SchemaEngine[DeclarativeSchemaEngine::parseWidgetSchema]
            SchemaEngine --> CheckManifest{manifest.json valid?}
            CheckManifest -- No --> Reject[Interface Validation Failed]
            CheckManifest -- Yes --> CheckBackend{Backend Target Exists?}
            CheckBackend -- No --> Reject
            CheckBackend -- Yes --> Register[Register Plugin in DashMap & CoreStorage]
        ```
    ]]

    Background
    {
        Given "a developer creates a custom plugin package for Paper-Alpha"
        And "the Core directory validator is active"
    }

    Rule "Compliant Plugin Structure and Declarative Schema"
    {
        @component(PluginScanner::validateManifest)
        @component(DeclarativeSchemaEngine::parseWidgetSchema)
        @diagram(PluginValidationFlow)
        Scenario PackageCompliantPluginWithDeclarativeSchema
        {
            Title "Creating a valid plugin package with manifest and declarative widgets"

            Given "a plugin folder contains 'manifest.json' declaring valid 'widgets' schema"
            And "provides a declared backend target"
            When "the package is scanned by the Core engine"
            Then "structural validation passes successfully"
            And "the plugin is marked as compliant"
        }

        @component(DeclarativeSchemaEngine::parseWidgetSchema)
        Scenario SupportNestedWidgetContainers
        {
            Title "Supporting nested container schema with Cards, Charts, and Action Groups"

            Given "a plugin manifest declares a 'Card' root element"
            And "the Card contains a nested 'CandlestickChart' and a horizontal 'Group' of 'Label' and 'Button'"
            When "DeclarativeSchemaEngine parses the manifest"
            Then "the hierarchical component tree is constructed successfully"
            And "all child components are validated"
        }
    }

    Rule "Data Feed and Data Consumer Manifest Declarations"
    {
        @component(PluginScanner::validateManifest)
        Scenario ValidateDataFeedPluginEmissions
        {
            Title "Data Feed plugin manifest declares emitted variables and streaming modes"

            Given "a plugin manifest specifies category 'data_feed'"
            And "contains an 'emits' array declaring variables with 'streaming' and 'non_streaming' transmission types"
            When "PluginScanner validates the manifest"
            Then "the emissions declaration is verified successfully"
            And "the plugin is marked as compliant Data Feed"
        }

        @component(PluginScanner::validateManifest)
        Scenario ValidateDataConsumerPluginConsumptions
        {
            Title "Data Consumer plugin manifest declares consumed variables and data streams"

            Given "a plugin manifest specifies category 'data_consumer'"
            And "contains a 'consumes' array declaring required input streams and variables"
            When "PluginScanner validates the manifest"
            Then "the consumptions declaration is verified successfully"
            And "the plugin is marked as compliant Data Consumer"
        }

        @component(PluginScanner::validateManifest)
        Scenario RejectDataFeedMissingEmits
        {
            Title "Data Feed plugin rejected when emits array is missing or invalid"

            Given "a plugin specifies category 'data_feed' but lacks an 'emits' declaration"
            When "PluginScanner evaluates the manifest"
            Then "validation fails with missing emissions specification error"
            And "the plugin is marked as 'Interface Validation Failed'"
        }

        @component(PluginScanner::validateManifest)
        Scenario RejectDataConsumerMissingConsumes
        {
            Title "Data Consumer plugin rejected when consumes array is missing or invalid"

            Given "a plugin specifies category 'data_consumer' but lacks a 'consumes' declaration"
            When "PluginScanner evaluates the manifest"
            Then "validation fails with missing consumptions specification error"
            And "the plugin is marked as 'Interface Validation Failed'"
        }
    }

    Rule "Multi-Format Backend Execution Targets"
    {
        @component(PluginScanner::validateManifest)
        @component(ProcessSupervisor::spawnSubprocess)
        Scenario SupportCompiledBinaryBackend
        {
            Title "Supporting native compiled binary backend target"

            Given "a plugin specifies backend type 'binary' with executable 'bin/plugin-name-linux-x86_64'"
            When "the application validates and launches the plugin"
            Then "the binary backend is recognized as valid execution target"
            And "the subprocess is spawned over local gRPC sockets"
        }

        @component(PluginScanner::validateManifest)
        @component(WasmRuntime::loadModule)
        Scenario SupportWasmModuleBackend
        {
            Title "Supporting sandboxed WASM module backend target"

            Given "a plugin specifies backend type 'wasm' with module 'bin/plugin-name.wasm'"
            When "the application validates and loads the plugin"
            Then "the WASM binary is compiled into an in-memory guest instance"
            And "WASM C-FFI hooks are registered"
        }

        @component(PluginScanner::validateManifest)
        @component(ProcessSupervisor::spawnSubprocess)
        Scenario SupportInterpretedScriptBackend
        {
            Title "Supporting interpreted Python script backend target"

            Given "a plugin specifies backend type 'interpreted' with entrypoint 'src/main.py'"
            When "the application validates and spawns the plugin"
            Then "the Python interpreter is spawned pointing to main.py"
            And "the subprocess connects to the Core gRPC server"
        }
    }

    Rule "Structural Validation Failures and Missing Artifacts"
    {
        @component(PluginScanner::validateManifest)
        Scenario RejectMissingManifest
        {
            Title "Package rejected when manifest.json is missing"

            Given "a plugin directory contains backend execution files"
            But "is missing the required 'manifest.json' file"
            When "the scanner inspects the directory"
            Then "validation fails"
            And "the plugin is marked as 'Interface Validation Failed'"
        }

        @component(PluginScanner::validateManifest)
        Scenario RejectMissingBackendTarget
        {
            Title "Package rejected when backend executable or script is missing"

            Given "a plugin directory contains 'manifest.json'"
            But "the declared backend binary file is not found on disk"
            When "the scanner inspects the directory"
            Then "validation fails"
            And "the application blocks the plugin from executing"
        }

        @component(PluginScanner::validateManifest)
        Scenario RejectMalformedJsonManifest
        {
            Title "Package rejected when manifest.json contains malformed JSON"

            Given "a plugin has a corrupted or unparseable 'manifest.json'"
            When "the scanner attempts to deserialize the manifest"
            Then "validation fails with a JSON parsing error"
            And "the plugin is disabled"
        }

        @component(DeclarativeSchemaEngine::parseWidgetSchema)
        Scenario RejectUnknownSchemaComponent
        {
            Title "Package rejected when manifest contains unknown widget component type"

            Given "a plugin manifest specifies a widget with invalid type 'UnsupportedVideoPlayer'"
            When "DeclarativeSchemaEngine evaluates the schema"
            Then "validation fails with an unknown element type error"
            And "the plugin is locked in the disabled state"
        }
    }

    Rule "Runtime Policy Enforcement and Structural Adherence"
    {
        @component(PluginPolicyEnforcer::enforceDataFeedEmission)
        @component(RouterService::dispatchStream)
        @protocol(PluginEnforcementProtocol::PolicyValidationPipe)
        Scenario BlockStreamingFeedFromSlowBus
        {
            Title "Data Feed plugin with streaming mode is strictly prohibited from accessing Slow Speed Bus"

            Given "a Data Feed plugin 'LiveTickFeed' specifies variable 'NVDA:ticks' with type 'streaming'"
            When "'LiveTickFeed' attempts to dispatch packets to the Slow Speed Event Bus"
            Then "PluginPolicyEnforcer rejects the dispatch"
            And "an error 'Streaming data feed cannot access slow bus' is returned"
        }

        @component(PluginPolicyEnforcer::enforceDataFeedEmission)
        @protocol(PluginEnforcementProtocol::PolicyViolationPipe)
        Scenario BlockUndeclaredVariableMutation
        {
            Title "Data Feed plugin cannot alter any variable not declared in its manifest emits"

            Given "a Data Feed plugin 'AlphaFeed' is executing"
            When "'AlphaFeed' attempts to emit variable 'UNAUTHORIZED_VAR' not listed in its manifest 'emits'"
            Then "PluginPolicyEnforcer intercepts and blocks the mutation"
            And "a policy violation event is logged"
        }

        @component(PluginPolicyEnforcer::enforceDataConsumerAccess)
        @component(RouterService::routeCommand)
        @protocol(PluginEnforcementProtocol::PolicyViolationPipe)
        Scenario BlockDataConsumerSendingData
        {
            Title "Data Consumer plugins can only consume and are strictly forbidden from sending data"

            Given "a Data Consumer plugin 'MovingAverageCalculator' is executing"
            When "'MovingAverageCalculator' attempts to transmit outbound stream data"
            Then "PluginPolicyEnforcer blocks the transmission"
            And "an error 'Data consumer plugins are forbidden from sending data' is returned"
        }

        @component(PluginPolicyEnforcer::enforceDataConsumerAccess)
        Scenario BlockDirectInterPluginCalls
        {
            Title "Data Consumer plugins cannot directly call other plugins"

            Given "a Data Consumer plugin 'PortfolioAnalytics' is executing"
            When "'PortfolioAnalytics' attempts to directly invoke 'Binance Order Execution' plugin"
            Then "PluginPolicyEnforcer denies the direct call"
            And "inter-plugin isolation is strictly maintained"
        }

        @component(PluginPolicyEnforcer::enforceDataConsumerAccess)
        Scenario BlockUndeclaredTopicConsumption
        {
            Title "Data Consumer plugins cannot consume anything not specified in manifest consumes"

            Given "a Data Consumer plugin specifies consumes array containing only 'raw:ticks'"
            When "the plugin requests subscription to undeclared topic 'confidential:orders'"
            Then "PluginPolicyEnforcer rejects the subscription request"
        }
    }
}
