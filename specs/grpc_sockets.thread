syntax = component

Component: "gRPC Sockets"
  Note: [[The gRPC Sockets component manages local inter-process communication (IPC) for native out-of-process plugins. 
  It initializes Tonic servers listening on Unix Domain Sockets (UDS) for Unix environments or Named Pipes for Windows systems, 
  serving as the physical layer for bi-directional Protobuf message streaming.]]

  Diagram: "classDiagram" [[
    class GrpcSockets {
      +bind_socket(socket_path: String) -> SocketListener
      +accept_connection(listener: SocketListener) -> GrpcStream
      +send_message(stream: GrpcStream, data: Bytes) -> Result
    }
  ]]

  Invariants:
    * "Native gRPC communication must run strictly over local IPC channels and never bind to external ports (e.g. 0.0.0.0)."
    * "All communication socket files or Named Pipe nodes must belong to the active host user process permissions."

  Non-Functional:
    * "Bi-directional UDS messaging overhead must not exceed 50 microseconds."

  Models:
    Model: "SocketListener"
      Type: "Struct"
      Members:
        * "file_path: String - The socket file or named pipe identifier"
        * "handle: Pointer - OS socket handle pointer reference"

    Model: "GrpcStream"
      Type: "Struct"
      Members:
        * "stream_ptr: Pointer - Memory address referencing the connection IO socket handle"

  Contracts:
    Contract: "BindSocket"
      Signature: "+bind_socket(socket_path: String) -> SocketListener"
      Inputs:
        * "socket_path: String - Filepath for socket creation"
      Outputs:
        * "listener: SocketListener - Bound listener instance"
      Requires:
        * "Process possesses write permissions on the socket directory."
      Ensures:
        * "A listener binds to the socket path and sweeps any previous stale socket file."
      Precondition:
        * "The socket_path must represent a valid path format."
      Postcondition:
        * "The socket file is generated on disk and listens for plugin calls."
      Process:
        1. "Check if socket_path already exists on the filesystem."
        2. "If exists, delete stale file using tokio::fs::remove_file."
        3. "Initialize UnixListener bind configuration."
        4. "Bind socket listener to path."
        5. "Return SocketListener."
