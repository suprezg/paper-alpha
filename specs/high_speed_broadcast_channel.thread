syntax = component

Component: "High Speed Broadcast Channel"
  Note: [[The High Speed Broadcast Channel is an in-memory, high-throughput multi-producer, multi-consumer 
  event stream bus implemented using tokio broadcast channels. It handles real-time data flows (tick indicators, option books) 
  and routes them straight to Webview visual widget buffers at microsecond latencies, bypassing all disk operations.]]

  Diagram: "classDiagram" [[
    class HighSpeedBroadcastChannel {
      +publish_stream(envelope: StreamEnvelope) -> Result
      +subscribe_topic(subscriber_id: String, topic: String) -> ChannelReceiver
      +unsubscribe_topic(subscriber_id: String, topic: String) -> Result
    }
  ]]

  Invariants:
    * "Payloads passing through the High Speed Broadcast Channel must never trigger disk database writes or read lookups."
    * "All streaming envelopes must be binary buffers or flat byte streams."

  Non-Functional:
    * "The bus must support fanning out 100,000+ messages per second at sub-10 microsecond latency."
    * "Memory footprint of message allocations must rely on zero-copy reference counted byte arrays (Bytes)."

  Models:
    Model: "StreamEnvelope"
      Type: "Struct"
      Members:
        * "topic: String - The target topic path"
        * "publisher_id: String - Unique publisher process name"
        * "sequence_id: uint64 - Monotonic sequence timestamp"
        * "hop_trace: List<String> - List of traversed plugin nodes"
        * "payload: Bytes - Binary raw data stream content"

    Model: "ChannelReceiver"
      Type: "Struct"
      Members:
        * "receiver_ptr: Pointer - Memory pointer referencing the broadcast subscriber thread hook"

  Contracts:
    Contract: "PublishStream"
      Signature: "+publish_stream(envelope: StreamEnvelope) -> Result"
      Inputs:
        * "envelope: StreamEnvelope - The high-frequency streaming packet"
      Outputs:
        * "result: Result - Success void or failure state"
      Requires:
        * "Active subscriber pools are tracked in the subscription count registry."
      Ensures:
        * "Envelope payload is broadcasted immediately to all matching subscribers in memory."
      Precondition:
        * "The envelope must pass the hop_trace loop cycle validation."
      Postcondition:
        * "All in-memory receivers get the cloned pointer reference to the data."
      Process:
        1. "Identify the broadcast sender channel mapping to envelope.topic."
        2. "If channel is missing, create a new tokio broadcast channel dynamically."
        3. "Broadcast the envelope.payload reference to all receiver handles."
        4. "Return Result::Ok."
