syntax = component

Component: "Wasm Runtime"
  Note: [[The Wasm Runtime compiles, links, and executes in-memory WebAssembly plugins (e.g. high-frequency logic calculations). 
  It leverages wasmtime-wasi to isolate guest instances, allowing zero-copy memory pointer sharing over C-FFI while restricting 
  raw filesystem and host process resources.]]

  Diagram: "classDiagram" [[
    class WasmRuntime {
      +load_module(wasm_bytes: Bytes) -> InstanceId
      +execute_guest_function(instance: InstanceId, export_name: String, params: FfiParams) -> FfiResult
      +deallocate_guest_memory(instance: InstanceId, ptr: Pointer, len: Size) -> Result
    }
  ]]

  Invariants:
    * "All WASM modules must run in isolated instance environments with no default OS access."
    * "WASM linear memory space must be strictly bounded."

  Non-Functional:
    * "Ffi function calls between Host Core and Guest WASM must execute in under 1 microsecond."

  Models:
    Model: "FfiParams"
      Type: "Struct"
      Members:
        * "pointer: uint32 - Memory offset in guest heap"
        * "length: uint32 - Length of byte buffer"

    Model: "FfiResult"
      Type: "Struct"
      Members:
        * "pointer: uint32 - Memory offset in guest heap"
        * "length: uint32 - Length of returned buffer"

    Model: "InstanceId"
      Type: "Struct"
      Members:
        * "id: String - Unique guest instance token"

  Contracts:
    Contract: "ExecuteGuestFunction"
      Signature: "+execute_guest_function(instance: InstanceId, export_name: String, params: FfiParams) -> FfiResult"
      Inputs:
        * "instance: InstanceId - The VM instance reference"
        * "export_name: String - Name of function export to execute"
        * "params: FfiParams - Pointer and length details in guest memory"
      Outputs:
        * "result: FfiResult - Return pointer and size information"
      Requires:
        * "The specified VM instance must be initialized and active."
      Ensures:
        * "Function execution terminates or traps on resource exhaustion."
      Precondition:
        * "The target function name must exist in guest exports."
      Postcondition:
        * "Guest changes do not violate VM sandboxing limitations."
      Process:
        1. "Lookup target instance and confirm memory bounds validation."
        2. "Write inputs to guest memory allocation block."
        3. "Invoke guest export function over C-FFI."
        4. "Catch any runtime execution traps or division exceptions."
        5. "Extract results from output pointer registers."
        6. "Return FfiResult."
